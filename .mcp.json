{
  "mcpServers": {
    "market-advisory": {
      "command": "node",
      "args": ["mcp-server/dist/index.js"],
      "env": {
        "NODE_USE_ENV_PROXY": "1",
        "ALPACA_API_KEY_ID": "${ALPACA_API_KEY_ID}",
        "ALPACA_API_SECRET_KEY": "${ALPACA_API_SECRET_KEY}",
        "KRAKEN_READONLY_API_KEY": "${KRAKEN_READONLY_API_KEY}",
        "KRAKEN_READONLY_API_SECRET": "${KRAKEN_READONLY_API_SECRET}"
      }
    }
  }
}
